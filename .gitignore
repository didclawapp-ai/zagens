# =============================================================================
# Remote push policy: only source, configs, and small tracked assets.
# Build outputs, secrets, local harness results, and internal notes stay local.
# Website / installers: private zagens_website repo + VPS /download/ only.
# =============================================================================

# Build artifacts
/target
*.pdb
*.exe
*.msi
# Installers — never in product repo (zagens_website + VPS /download/)
**/*.exe
**/*.exe.zip
**/download/Zagens_*
**/public/download/Zagens_*
*.dll
*.so
*.dylib
*.rlib
*.o

# Development
.env
.env.*
!.env.example
node_modules/
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
venv/
ENV/
env/
.venv/
*.egg-info/
dist/

# Logs
*.log

# Generated
outputs/
tmp/
results/lht-eval/
results/lht-harness/
crates/desktop/bundle-legal/

