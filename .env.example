# Zagens — runtime sidecar environment
#
# Zagens stores user settings in ~/.zagens/config.toml (Settings UI).
# Shell-exported variables override values in this file when present.
#
# Copy to `.env` for local dev / sidecar debugging only. Do not commit `.env`.

# ── DeepSeek API (default provider) ─────────────────────────────────────────
# Get a key from https://platform.deepseek.com — keep it local.
# DEEPSEEK_API_KEY=

# Global endpoint:
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# China endpoint:
# DEEPSEEK_BASE_URL=https://api.deepseeki.com

# V4 model IDs (compatibility aliases such as deepseek-chat normalize at runtime):
# DEEPSEEK_MODEL=deepseek-v4-pro
# DEEPSEEK_MODEL=deepseek-v4-flash

# ── Vision bridge (`describe_image` tool) ───────────────────────────────────
# VISION_API_KEY=
# VISION_BASE_URL=https://api.siliconflow.cn/v1
# VISION_MODEL=Qwen/Qwen3-VL-32B-Instruct
# SILICONFLOW_API_KEY=   # fallback if VISION_API_KEY is unset

# ── NVIDIA NIM (optional provider) ──────────────────────────────────────────
# DEEPSEEK_PROVIDER=nvidia-nim
# NVIDIA_API_KEY=
# NVIDIA_NIM_API_KEY=
# NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_NIM_MODEL=deepseek-ai/deepseek-v4-pro

# ── Logging (sidecar / runtime) ─────────────────────────────────────────────
# DEEPSEEK_LOG_LEVEL=debug
# RUST_LOG=deepseek_tui=debug

# ── Agent safety (defaults; Zagens Settings can override) ───────────────────
# DEEPSEEK_APPROVAL_POLICY=on-request
# DEEPSEEK_SANDBOX_MODE=workspace-write
# DEEPSEEK_ALLOW_SHELL=true

# ── Optional paths ──────────────────────────────────────────────────────────
# DEEPSEEK_SKILLS_DIR=~/.zagens/skills
# DEEPSEEK_MCP_CONFIG=~/.zagens/mcp.json
