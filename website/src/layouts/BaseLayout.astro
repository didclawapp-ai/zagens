---
import '@/styles/global.css';
import type { Locale, SiteCopy } from '@/i18n';
import { localePath } from '@/i18n';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';

interface Props {
  locale: Locale;
  copy: SiteCopy;
  title: string;
  description?: string;
  currentPath: string;
}

const { locale, copy, title, description, currentPath } = Astro.props;
const pageDescription = description ?? copy.meta.defaultDescription;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/screenshots/hero.png', Astro.site).href;
const pageTitle = `${title} · ${copy.meta.siteName}`;
const ogLocale = locale === 'zh-Hans' ? 'zh_CN' : 'en_US';

const altLinks = [
  { hreflang: 'en', href: new URL(localePath('en', currentPath), Astro.site).href },
  { hreflang: 'zh-Hans', href: new URL(localePath('zh-Hans', currentPath), Astro.site).href },
  { hreflang: 'x-default', href: new URL(localePath('en', currentPath), Astro.site).href },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: copy.meta.siteName,
  description: copy.meta.defaultDescription,
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Windows 10, Windows 11',
  url: Astro.site?.href,
  image: ogImage,
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
};
---

<!doctype html>
<html lang={locale === 'zh-Hans' ? 'zh-Hans' : 'en'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDescription} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#faf9f7" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/icon.png" />
    <link rel="apple-touch-icon" href="/icon.png" />
    <link rel="canonical" href={canonical} />
    {altLinks.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={copy.meta.siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />
    <title>{pageTitle}</title>
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-lg focus:bg-accent focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:text-white"
    >
      {locale === 'zh-Hans' ? '跳到主内容' : 'Skip to content'}
    </a>
    <Header locale={locale} copy={copy} currentPath={currentPath} />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer locale={locale} copy={copy} />
  </body>
</html>
