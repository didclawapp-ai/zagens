---
import type { Locale } from '@/i18n';
import { localeLabels, localePath } from '@/i18n';

interface Props {
  locale: Locale;
  currentPath: string;
  label: string;
}

const { locale, currentPath, label } = Astro.props;

const otherLocale: Locale = locale === 'en' ? 'zh-Hans' : 'en';
const switchHref = localePath(otherLocale, currentPath);
---

<div class="inline-flex items-center gap-1 rounded-full border border-card-border bg-card p-0.5 text-xs">
  <span class="sr-only">{label}</span>
  <a
    href={localePath('en', currentPath)}
    class:list={[
      'rounded-full px-2.5 py-1 transition-colors',
      locale === 'en' ? 'bg-accent text-white' : 'text-muted hover:text-ink',
    ]}
    aria-current={locale === 'en' ? 'page' : undefined}
  >
    EN
  </a>
  <a
    href={localePath('zh-Hans', currentPath)}
    class:list={[
      'rounded-full px-2.5 py-1 transition-colors',
      locale === 'zh-Hans' ? 'bg-accent text-white' : 'text-muted hover:text-ink',
    ]}
    aria-current={locale === 'zh-Hans' ? 'page' : undefined}
  >
    中文
  </a>
</div>
