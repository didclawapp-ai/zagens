---
import type { Locale, SiteCopy } from '@/i18n';
import { localePath } from '@/i18n';
import LocaleSwitcher from './LocaleSwitcher.astro';

interface Props {
  locale: Locale;
  copy: SiteCopy;
  currentPath: string;
}

const { locale, copy, currentPath } = Astro.props;

const links = [
  { path: '/', label: copy.nav.home },
  { path: '/download', label: copy.nav.download },
  { path: '/install', label: copy.nav.install },
];

function isActive(path: string): boolean {
  const href = localePath(locale, path);
  const here = localePath(locale, currentPath === '' ? '/' : currentPath);
  return href === here || (path !== '/' && here.startsWith(href));
}

const menuLabel = locale === 'zh-Hans' ? '菜单' : 'Menu';
const langLabel = locale === 'zh-Hans' ? '语言' : 'Language';
---

<header class="sticky top-0 z-50 border-b border-card-border/80 bg-canvas/90 backdrop-blur-md">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
    <a href={localePath(locale, '/')} class="flex items-center gap-2.5 font-semibold tracking-tight text-ink">
      <img src="/icon.png" alt="" width="28" height="28" class="rounded-md" />
      <span>{copy.meta.siteName}</span>
      <span class="rounded-full bg-accent-soft px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-accent">
        {copy.common.previewBadge}
      </span>
    </a>

    <nav class="hidden items-center gap-6 text-sm text-muted md:flex" aria-label="Primary">
      {
        links.map((link) => (
          <a
            href={localePath(locale, link.path)}
            aria-current={isActive(link.path) ? 'page' : undefined}
            class:list={[
              'transition-colors hover:text-ink',
              isActive(link.path) ? 'text-ink font-medium' : '',
            ]}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-3">
      <LocaleSwitcher locale={locale} currentPath={currentPath} label={langLabel} />
      <a
        href={localePath(locale, '/download')}
        class="hidden rounded-lg bg-accent px-3 py-1.5 text-sm font-medium text-white hover:bg-accent-hover sm:inline-flex"
      >
        {copy.nav.download}
      </a>
      <button
        type="button"
        id="mobile-menu-toggle"
        class="inline-flex items-center justify-center rounded-lg border border-card-border bg-card p-2 text-ink md:hidden"
        aria-label={menuLabel}
        aria-controls="mobile-menu"
        aria-expanded="false"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6" />
          <line x1="3" y1="12" x2="21" y2="12" />
          <line x1="3" y1="18" x2="21" y2="18" />
        </svg>
      </button>
    </div>
  </div>

  <nav
    id="mobile-menu"
    class="hidden border-t border-card-border bg-canvas md:hidden"
    aria-label="Mobile"
  >
    <div class="mx-auto max-w-6xl px-4 py-3 sm:px-6">
      <ul class="flex flex-col">
        {
          links.map((link) => (
            <li>
              <a
                href={localePath(locale, link.path)}
                aria-current={isActive(link.path) ? 'page' : undefined}
                class:list={[
                  'block rounded-lg px-3 py-2.5 text-sm transition-colors hover:bg-canvas-alt',
                  isActive(link.path) ? 'font-medium text-ink' : 'text-muted',
                ]}
              >
                {link.label}
              </a>
            </li>
          ))
        }
        <li class="mt-1">
          <a
            href={localePath(locale, '/download')}
            class="block rounded-lg bg-accent px-3 py-2.5 text-center text-sm font-medium text-white hover:bg-accent-hover"
          >
            {copy.nav.download}
          </a>
        </li>
      </ul>
    </div>
  </nav>
</header>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const open = menu.classList.toggle('hidden');
      toggle.setAttribute('aria-expanded', open ? 'false' : 'true');
    });
  }
</script>
