---
import type { Locale, SiteCopy } from '@/i18n';
import { localePath } from '@/i18n';

interface Props {
  locale: Locale;
  copy: SiteCopy;
}

const { locale, copy } = Astro.props;
const year = new Date().getFullYear();

const productLinks = [
  { path: '/', label: copy.nav.home },
  { path: '/download', label: copy.nav.download },
  { path: '/install', label: copy.nav.install },
];
const legalLinks = [
  { path: '/privacy', label: copy.nav.privacy },
  { path: '/terms', label: copy.nav.terms },
];
const productTitle = locale === 'zh-Hans' ? '产品' : 'Product';
const legalTitle = locale === 'zh-Hans' ? '法律' : 'Legal';
---

<footer class="mt-auto border-t border-card-border bg-canvas-alt">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 sm:px-6 md:grid-cols-[2fr_1fr_1fr]">
    <div>
      <div class="flex items-center gap-2.5">
        <img src="/icon.png" alt="" width="28" height="28" class="rounded-md" />
        <span class="font-semibold tracking-tight text-ink">{copy.meta.siteName}</span>
      </div>
      <p class="mt-3 max-w-xs text-sm text-muted">{copy.footer.tagline}</p>
    </div>

    <nav aria-label={productTitle}>
      <p class="text-xs font-semibold uppercase tracking-wide text-subtle">{productTitle}</p>
      <ul class="mt-3 space-y-2 text-sm text-muted">
        {
          productLinks.map((link) => (
            <li>
              <a class="transition-colors hover:text-ink" href={localePath(locale, link.path)}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav aria-label={legalTitle}>
      <p class="text-xs font-semibold uppercase tracking-wide text-subtle">{legalTitle}</p>
      <ul class="mt-3 space-y-2 text-sm text-muted">
        {
          legalLinks.map((link) => (
            <li>
              <a class="transition-colors hover:text-ink" href={localePath(locale, link.path)}>
                {link.label}
              </a>
            </li>
          ))
        }
        <li>
          <a
            class="transition-colors hover:text-ink"
            href={`mailto:${copy.common.supportEmail}`}
          >
            {copy.common.contact}
          </a>
        </li>
      </ul>
    </nav>
  </div>
  <div class="border-t border-card-border">
    <div class="mx-auto max-w-6xl px-4 py-5 sm:px-6">
      <p class="text-xs text-subtle">© {year} {copy.footer.copyright}</p>
    </div>
  </div>
</footer>
