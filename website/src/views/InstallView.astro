---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import { getCopy, localePath, type Locale } from '@/i18n';

interface Props {
  locale: Locale;
  currentPath: string;
}

const { locale, currentPath } = Astro.props;
const copy = getCopy(locale);
const t = copy.install;
---

<BaseLayout locale={locale} copy={copy} title={t.title} currentPath={currentPath}>
  <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
    <h1 class="text-3xl font-semibold tracking-tight text-ink">{t.title}</h1>
    <p class="mt-3 text-muted">{t.subtitle}</p>

    <div class="prose-zagens mt-10">
      <h2>{t.recommendedTitle}</h2>
      <ol>
        {t.steps.map((step) => <li>{step}</li>)}
      </ol>
      <blockquote>{t.unblockWarning}</blockquote>

      <h2>{t.alternativeTitle}</h2>
      <ol>
        {t.alternativeSteps.map((step) => <li>{step}</li>)}
      </ol>

      <h2>{t.verifyTitle}</h2>
      <p>{t.verifyBody}</p>
      <pre class="rounded-lg bg-canvas-alt p-4 text-sm"><code>{`Get-FileHash .\\Zagens_*_x64-setup.exe.zip -Algorithm SHA256
Get-Content .\\Zagens_*_x64-setup.exe.zip.sha256`}</code></pre>

      <h2>{t.requirementsTitle}</h2>
      <ul>
        {t.requirements.map((item) => <li>{item}</li>)}
      </ul>

      <h2>{t.whyUnsignedTitle}</h2>
      <p>{t.whyUnsignedBody}</p>
    </div>

    <div class="mt-10">
      <Button href={localePath(locale, '/download')}>{copy.nav.download}</Button>
    </div>
  </div>
</BaseLayout>
