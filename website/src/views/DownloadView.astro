---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import release from '@/data/release.json';
import { getCopy, localePath, type Locale } from '@/i18n';

interface Props {
  locale: Locale;
  currentPath: string;
}

const { locale, currentPath } = Astro.props;
const copy = getCopy(locale);
const t = copy.download;

const win = release.platforms['windows-x64'];
const hasUrls = Boolean(win.zip.url && win.exe.url);
const releaseUrl = release.githubRepo
  ? `https://github.com/${release.githubRepo}/releases/tag/${release.githubReleaseTag}`
  : '#';
---

<BaseLayout locale={locale} copy={copy} title={t.title} currentPath={currentPath}>
  <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
    <h1 class="text-3xl font-semibold tracking-tight text-ink">{t.title}</h1>
    <p class="mt-3 text-muted">{t.subtitle}</p>
    <p class="mt-2 text-sm text-subtle">
      v{release.version}
      {release.publishedAt ? ` · ${release.publishedAt}` : ''}
    </p>

    {
      !hasUrls && (
        <div
          class="mt-8 rounded-xl border border-warning/30 bg-warning-bg px-4 py-3 text-sm text-ink"
          role="status"
        >
          {t.noReleaseYet}
        </div>
      )
    }

    <div class="mt-10 space-y-4">
      <article class="rounded-xl border-2 border-accent/20 bg-card p-6 shadow-sm">
        <div class="flex items-start justify-between gap-4">
          <div>
            <p class="text-xs font-semibold uppercase tracking-wide text-accent">{t.recommended}</p>
            <h2 class="mt-1 text-lg font-semibold text-ink">{t.zipTitle}</h2>
            <p class="mt-1 text-sm text-muted">{t.zipHint}</p>
            <p class="mt-2 font-mono text-xs text-subtle">{win.zip.filename}</p>
          </div>
        </div>
        <div class="mt-5 flex flex-wrap gap-3">
          {
            hasUrls ? (
              <Button href={win.zip.url} external>
                {locale === 'zh-Hans' ? '下载 zip' : 'Download zip'}
              </Button>
            ) : (
              <Button href={releaseUrl} external variant="secondary">
                GitHub Releases
              </Button>
            )
          }
          <Button href={localePath(locale, '/install')} variant="secondary">
            {copy.nav.install}
          </Button>
        </div>
        {
          win.zip.sha256 && (
            <p class="mt-4 break-all font-mono text-xs text-subtle">
              {t.sha256}: {win.zip.sha256}
            </p>
          )
        }
      </article>

      <article class="rounded-xl border border-card-border bg-card p-6">
        <h2 class="text-lg font-semibold text-ink">{t.exeTitle}</h2>
        <p class="mt-1 text-sm text-muted">{t.exeHint}</p>
        <p class="mt-2 font-mono text-xs text-subtle">{win.exe.filename}</p>
        <div class="mt-5">
          {
            hasUrls && win.exe.url ? (
              <Button href={win.exe.url} external variant="secondary">
                {locale === 'zh-Hans' ? '下载 .exe' : 'Download .exe'}
              </Button>
            ) : (
              <span class="text-sm text-subtle">—</span>
            )
          }
        </div>
        {
          win.exe.sha256 && (
            <p class="mt-4 break-all font-mono text-xs text-subtle">
              {t.sha256}: {win.exe.sha256}
            </p>
          )
        }
      </article>
    </div>

    <p class="mt-8 text-sm text-muted">{t.verifyHint}</p>
    <p class="mt-4 text-sm text-muted">{t.apiKeyNote}</p>

    {
      release.githubReleaseTag && (
        <p class="mt-6 text-sm">
          {t.releaseNotes}:{' '}
          <a class="text-accent hover:underline" href={releaseUrl} target="_blank" rel="noopener noreferrer">
            {release.githubReleaseTag}
          </a>
        </p>
      )
    }
  </div>
</BaseLayout>
