---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCopy, type Locale } from '@/i18n';

interface Props {
  locale: Locale;
  currentPath: string;
}

const { locale, currentPath } = Astro.props;
const copy = getCopy(locale);
const t = copy.privacy;
const updated = '2026-06-02';
---

<BaseLayout locale={locale} copy={copy} title={t.title} currentPath={currentPath}>
  <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
    <h1 class="text-3xl font-semibold tracking-tight text-ink">{t.title}</h1>
    <p class="mt-2 text-sm text-subtle">{copy.common.lastUpdated}: {updated}</p>
    <p class="mt-4 text-muted">{t.intro}</p>

    <div class="prose-zagens mt-10">
      {
        t.sections.map((section) => (
          <>
            <h2>{section.heading}</h2>
            <p>{section.body}</p>
          </>
        ))
      }
    </div>
  </div>
</BaseLayout>
