# Example: /etc/nginx/sites-available/zagens
# Replace server_name and root if you use a different path.

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name zagens.com www.zagens.com 43.160.233.39;

    root /var/www/zagens;
    index index.html;

    # Astro static export: clean URLs map to .html or directories
    location / {
        try_files $uri $uri/ $uri.html /index.html;
    }

    # Installer artifacts — separate log for download counter (see scripts/aggregate-download-stats.mjs)
    location ~ ^/download/.+\.(exe|zip)$ {
        access_log /var/log/nginx/zagens-download.log combined;
        add_header Cache-Control "public, max-age=300";
        try_files $uri =404;
    }

    location /download/ {
        add_header Cache-Control "public, max-age=300";
        try_files $uri $uri/index.html =404;
    }

    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|webp|woff2?)$ {
        add_header Cache-Control "public, max-age=604800, immutable";
        try_files $uri =404;
    }

    # Deny dotfiles (.env leaks, etc.)
    location ~ /\. {
        deny all;
    }
}
