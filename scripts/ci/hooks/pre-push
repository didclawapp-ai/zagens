#!/bin/sh
# Lint gate before push (mirrors CI Lint when the push gate requires full CI).
# Skip local lint: SKIP_VERIFY=1 git push
# Skip via gate (docs-only diff or [skip ci] in commit): automatic — see ci-push-gate.sh
set -e
if [ "${SKIP_VERIFY:-}" = "1" ]; then
  echo "pre-push: SKIP_VERIFY=1, skipping verify-lint"
  exit 0
fi
root="$(git rev-parse --show-toplevel)"
cd "${root}"
if command -v bash >/dev/null 2>&1; then
  if bash scripts/ci/ci-push-gate.sh --local; then
    echo "pre-push: ci-push-gate skipped verify-lint (docs / [skip ci])"
    exit 0
  fi
  bash scripts/ci/verify-lint.sh
elif command -v pwsh >/dev/null 2>&1; then
  echo "pre-push: ci-push-gate requires bash; running verify-lint.ps1" >&2
  pwsh -NoProfile -File scripts/ci/verify-lint.ps1
else
  echo "pre-push: need bash or pwsh to run verify-lint" >&2
  exit 1
fi
