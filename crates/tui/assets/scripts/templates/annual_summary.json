{
  "title": "{{COMPANY_NAME}} {{YEAR}}年度总结",
  "subtitle": "{{DEPT_NAME}}  |  汇报人：{{PRESENTER}}  |  {{DATE}}",
  "theme": {
    "bg": "#0A1628",
    "accent": "#D4AF37",
    "title": "#FFFFFF",
    "body": "#D0D4DC",
    "muted": "#8899AA",
    "font": "Microsoft YaHei"
  },
  "slides": [
    {
      "title": "年度关键业绩指标",
      "layout": {"kind": "grid", "cols": [0.5, 0.5], "gap": "0.25in", "padding": "0.1in"},
      "blocks": [
        {
          "type": "chart",
          "chart": {
            "type": "bar",
            "categories": ["Q1", "Q2", "Q3", "Q4"],
            "series": [
              {"name": "营收 (万元)", "values": [1200, 1450, 1680, 1920]},
              {"name": "目标", "values": [1100, 1300, 1500, 1800]}
            ],
            "chart_title": "季度营收 vs 目标",
            "data_labels": true
          }
        },
        {
          "type": "chart",
          "chart": {
            "type": "line",
            "categories": ["1月", "3月", "5月", "7月", "9月", "11月"],
            "series": [
              {"name": "客户满意度", "values": [82, 85, 87, 88, 90, 92]},
              {"name": "NPS", "values": [42, 45, 48, 50, 52, 55]}
            ],
            "chart_title": "客户满意度与NPS趋势",
            "data_labels": true
          }
        }
      ],
      "notes": "{{KPI_NOTES}}"
    },
    {
      "title": "年度里程碑与成就",
      "layout": {"kind": "grid", "cols": [0.45, 0.55], "gap": "0.2in", "padding": "0.15in"},
      "blocks": [
        {
          "type": "table",
          "table": {
            "headers": ["季度", "里程碑", "状态"],
            "rows": [
              ["Q1", "{{M1_Q1}}", "✅"],
              ["Q1", "{{M2_Q1}}", "✅"],
              ["Q2", "{{M1_Q2}}", "✅"],
              ["Q2", "{{M2_Q2}}", "✅"],
              ["Q3", "{{M1_Q3}}", "✅"],
              ["Q4", "{{M1_Q4}}", "✅"],
              ["Q4", "{{M2_Q4}}", "✅"]
            ]
          }
        },
        {
          "type": "richtext",
          "runs": [
            {"t": "年度关键数字\n\n", "size": 18, "bold": true, "color": "#D4AF37"},
            {"t": "总营收\n", "size": 13},
            {"t": "{{TOTAL_REV}} 万元\n", "size": 24, "bold": true, "color": "#D4AF37"},
            {"t": "同比增长 ", "size": 13},
            {"t": "{{YOY_GROWTH}}\n\n", "size": 16, "bold": true, "color": "#00AA66"},
            {"t": "交付项目 ", "size": 13},
            {"t": "{{PROJECTS}} 个\n", "size": 16, "bold": true},
            {"t": "团队规模 ", "size": 13},
            {"t": "{{TEAM_SIZE}} 人\n", "size": 16, "bold": true},
            {"t": "客户续约率 ", "size": 13},
            {"t": "{{RENEWAL_RATE}}", "size": 16, "bold": true, "color": "#00AA66"}
          ]
        }
      ]
    },
    {
      "title": "财务概览",
      "table": {
        "headers": ["指标", "{{YEAR-1}}", "{{YEAR}}", "同比变化"],
        "rows": [
          ["营业收入 (万元)", "{{INC_PREV}}", "{{INC_CURR}}", "{{INC_DELTA}}"],
          ["毛利率", "{{GM_PREV}}", "{{GM_CURR}}", "{{GM_DELTA}}"],
          ["运营成本 (万元)", "{{OPEX_PREV}}", "{{OPEX_CURR}}", "{{OPEX_DELTA}}"],
          ["净利润 (万元)", "{{NP_PREV}}", "{{NP_CURR}}", "{{NP_DELTA}}"],
          ["研发投入 (万元)", "{{RD_PREV}}", "{{RD_CURR}}", "{{RD_DELTA}}"],
          ["人均产值 (万元)", "{{PP_PREV}}", "{{PP_CURR}}", "{{PP_DELTA}}"]
        ]
      },
      "bullets": [
        "{{FINANCIAL_SUMMARY_1}}",
        "{{FINANCIAL_SUMMARY_2}}"
      ]
    },
    {
      "title": "团队与文化建设",
      "layout": {"kind": "grid", "cols": [0.5, 0.5], "gap": "0.25in", "padding": "0.15in"},
      "blocks": [
        {
          "type": "table",
          "table": {
            "headers": ["项目", "数据"],
            "rows": [
              ["年度培训总时长", "{{TRAIN_HOURS}} 小时"],
              ["内部技术分享", "{{TECHSHARE}} 场"],
              ["员工满意度", "{{EMP_SATISFACTION}}"],
              ["核心人才保留率", "{{TALENT_RETENTION}}"],
              ["新入职员工", "{{NEW_HIRES}} 人"],
              ["晋升人数", "{{PROMOTIONS}} 人"]
            ]
          }
        },
        {
          "type": "richtext",
          "runs": [
            {"t": "团队荣誉\n\n", "size": 18, "bold": true, "color": "#D4AF37"},
            {"t": "{{HONOR_1}}\n\n", "size": 13},
            {"t": "{{HONOR_2}}\n\n", "size": 13},
            {"t": "文化建设\n\n", "size": 16, "bold": true, "color": "#D4AF37"},
            {"t": "{{CULTURE_1}}\n", "size": 13},
            {"t": "{{CULTURE_2}}\n", "size": 13},
            {"t": "{{CULTURE_3}}", "size": 13}
          ]
        }
      ]
    },
    {
      "title": "{{NEXT_YEAR}} 展望与目标",
      "table": {
        "headers": ["目标", "KPI", "责任人", "Q1", "Q2", "Q3", "Q4"],
        "rows": [
          ["{{GOAL1_NAME}}", "{{GOAL1_KPI}}", "{{GOAL1_OWNER}}", "{{GOAL1_Q1}}", "{{GOAL1_Q2}}", "{{GOAL1_Q3}}", "{{GOAL1_Q4}}"],
          ["{{GOAL2_NAME}}", "{{GOAL2_KPI}}", "{{GOAL2_OWNER}}", "{{GOAL2_Q1}}", "{{GOAL2_Q2}}", "{{GOAL2_Q3}}", "{{GOAL2_Q4}}"],
          ["{{GOAL3_NAME}}", "{{GOAL3_KPI}}", "{{GOAL3_OWNER}}", "{{GOAL3_Q1}}", "{{GOAL3_Q2}}", "{{GOAL3_Q3}}", "{{GOAL3_Q4}}"],
          ["{{GOAL4_NAME}}", "{{GOAL4_KPI}}", "{{GOAL4_OWNER}}", "{{GOAL4_Q1}}", "{{GOAL4_Q2}}", "{{GOAL4_Q3}}", "{{GOAL4_Q4}}"],
          ["{{GOAL5_NAME}}", "{{GOAL5_KPI}}", "{{GOAL5_OWNER}}", "{{GOAL5_Q1}}", "{{GOAL5_Q2}}", "{{GOAL5_Q3}}", "{{GOAL5_Q4}}"]
        ]
      },
      "bullets": [
        "{{OUTLOOK_SUMMARY_1}}",
        "{{OUTLOOK_SUMMARY_2}}"
      ]
    }
  ]
}
