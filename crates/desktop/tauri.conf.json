{
  "$schema": "https://raw.githubusercontent.com/nicepage/native/refs/heads/dev/packages/desktop-toolkit/tauri-schema.json",
  "productName": "Zagens",
  "version": "0.8.0",
  "identifier": "com.zagens.desktop",
  "build": {
    "frontendDist": "./web-ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "web-ui"
    },
    "beforeBuildCommand": {
      "script": "npm run bundle:prepare",
      "cwd": "."
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Zagens",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "visible": false,
        "transparent": false,
        "devtools": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://ipc.localhost:* http://127.0.0.1:* http://localhost:* http://tauri.localhost https://tauri.localhost http://tauri.localhost:* https://tauri.localhost:* https://zagens.com https://*.zagens.com ws://localhost:* wss://localhost:* ws://127.0.0.1:* wss://127.0.0.1:*; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data: blob:; font-src 'self' data: blob: http://localhost:* http://127.0.0.1:* https://tauri.localhost http://tauri.localhost"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "wix": {
        "version": "0.8.0"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/zagens-runtime"],
    "resources": {
      "binaries/python-standalone/python-install": "python/",
      "binaries/zagens-resources/": "zagens-resources/",
      "bundle-legal/": "legal/"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERDQTRCNDhBQjBBNjQ2OEMKUldTTVJxYXdpclNrM0h6ci8yQXFNVGJUUm5DbUVpRGFGMDJPYkVYbUxSNTdHS21iOWJTbnBzZHcK",
      "endpoints": [
        "https://zagens.com/download/latest.json"
      ],
      "windows": {
        "installMode": "basicUi"
      }
    }
  }
}
